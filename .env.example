# Copy this file to .env and fill in the values.
# The service reads this file directly; Docker does not need env_file/env vars.

# Required for provisioning new temporary mailboxes.
MOEMAIL_BASE_URL=https://mail.mui.moe
MOEMAIL_API_KEY=
# Optional: multiple domains (comma/space/newline separated), random pick one for each account.
MOEMAIL_DOMAINS=moyii.de
# Optional single-domain fallback (used if MOEMAIL_DOMAINS is empty).
MOEMAIL_DOMAIN=

# Optional default system prompt for newly provisioned agents.
# Leave empty to create agents without a default system prompt.
ALMMA_AGENT_INSTRUCTIONS=

# Optional if you run the solver elsewhere.
# Default in config.json is http://turnstile-solver:5000 for docker-compose.
# Change config.json if you need another solver endpoint.

# Optional. If empty, each generated account gets a random password stored in data/state.json.
ALMMA_ACCOUNT_PASSWORD=

# Optional but recommended for stable deployment.
# If empty, the service auto-generates and persists them in data/state.json.
ALMMA_SERVICE_API_KEY=
ALMMA_ADMIN_API_KEY=

# Optional outbound proxy for the Node service.
# docker-compose.yml already sets this to http://warp:1080 for the local WARP container.
ALMMA_OUTBOUND_PROXY=
